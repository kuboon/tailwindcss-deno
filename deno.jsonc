{
  "name": "@kuboon/tailwindcss-deno",
  "version": "0.1.0",
  "exports": "./src/index.ts",
  "imports": {
    "@deno/loader": "jsr:@deno/loader@^0.3.11",
    "@std/assert": "jsr:@std/assert@^1.0.17",
    "@std/path": "jsr:@std/path@^1.1.4",
    "@std/fs": "jsr:@std/fs@^1.0.22",
    "@jridgewell/remapping": "npm:@jridgewell/remapping@^2.3.5",
    "daisyui": "npm:daisyui@^5.5.14",
    "lightningcss": "npm:lightningcss@^1.31.1",
    "magic-string": "npm:magic-string@^0.30.21",
    "source-map-js": "npm:source-map-js@^1.2.1",
    "tailwindcss": "npm:tailwindcss@^4.1.18"
  },
  "tasks": {
    "test": "deno test -P --allow-read=.,$HOME/.cache/deno"
  },
  "compilerOptions": {
    "lib": ["deno.window", "esnext"]
  },
  "permissions": {
    "default": {
      "read": {
        "allow": [], // overwritten on cli option [".", "$HOME/.cache/deno"],
        "ignore": true
      },
      "env": {
        "allow": ["DEBUG", "HOME"],
        "ignore": true
      },
      "sys": ["cpus", "networkInterfaces", "hostname"],
      "ffi": true
    }
  }, 
  "test": {
    "permissions": "default"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "README.md",
      "LICENSE",
      "deno.json"
    ],
    "exclude": [
      "src/tests/**",
      "examples/**"
    ]
  }
}
